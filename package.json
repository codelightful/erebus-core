{
  "name": "erebus-core",
  "version": "0.2.0",
  "description": "Base web library",
  "repository": "https://github.com/codelightful/erebus-core",
  "browser": "./dist/erebus-core.min.js",
  "main": "./src/index.mjs",
  "scripts": {
    "start": "npm-run-all --parallel watch serve",
    "serve": "web-dev-server",
    "watch": "rollup -c -w",
    "build": "rollup -c",
    "test": "mocha",
    "coverage": "c8 mocha",
    "lint": "eslint ./src/**/**.mjs",
    "validate": "npm-run-all lint test build"
  },
  "keywords": [
    "ui"
  ],
  "author": "Codelightful",
  "contributors": [
    "Frederid Palacios"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@web/dev-server": "^0.4.6",
    "c8": "^10.1.3",
    "eslint": "^9.35.0",
    "jsdom": "^27.0.0",
    "mocha": "^11.7.2",
    "npm-run-all": "^4.1.5",
    "rollup": "^3.29.5",
    "rollup-plugin-postcss": "^4.0.2",
    "sinon": "^21.0.0",
    "xhr-mock": "^2.5.1"
  }
}
